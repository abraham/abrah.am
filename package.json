{
  "name": "abrah-am",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Source for https://abrah.am",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/abrah.am.git"
  },
  "author": "Abraham Williams <abraham@abrah.am>",
  "homepage": "https://abrah.am",
  "bugs": {
    "url": "https://github.com/abraham/abrah.am/issues"
  },
  "engines": {
    "node": "26",
    "npm": "11"
  },
  "scripts": {
    "build": "astro check && astro build",
    "deploy": "npm run build && firebase deploy --only hosting --project abraham-d3850",
    "dev": "astro dev",
    "fix": "prettier --write .",
    "lighthouse": "npx lhci autorun",
    "lint": "concurrently npm:lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"src/**/*.css\"",
    "lint:sw": "tsc -p src/sw",
    "preview": "firebase emulators:start --only hosting --project demo-abrah-am",
    "start": "astro dev",
    "test": "npm run test:unit && npm run build && firebase emulators:exec --only hosting --project demo-abrah-am \"npm run lighthouse\"",
    "test:unit": "vitest run"
  },
  "keywords": [],
  "dependencies": {
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "astro": "7.4.2",
    "concurrently": "10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "5.5.7",
    "firebase-tools": "15.34.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-package": "2.0.0",
    "sanitize-html": "2.18.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5",
    "workbox-build": "7.4.1"
  }
}
