{
  "name": "abrah-am",
  "version": "1.0.0",
  "private": true,
  "description": "Source for https://abrah.am",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abraham/abrah.am.git"
  },
  "author": "Abraham Williams <abraham@abrah.am>",
  "homepage": "https://abrah.am",
  "bugs": {
    "url": "https://github.com/abraham/abrah.am/issues"
  },
  "engines": {
    "node": "22",
    "npm": "10"
  },
  "scripts": {
    "build": "astro check && astro build",
    "deploy": "npm run build && firebase deploy --only hosting",
    "dev": "astro dev",
    "fix": "prettier --write .",
    "lighthouse": "npx lhci autorun",
    "lint": "concurrently npm:lint:*",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check .",
    "lint:stylelint": "stylelint \"src/**/*.scss\"",
    "lint:sw": "tsc -p src/sw",
    "preview": "firebase emulators:start --only hosting",
    "start": "astro dev",
    "test": "npm run build && firebase emulators:exec --only hosting \"npm run lighthouse\""
  },
  "keywords": [],
  "dependencies": {
    "@material/chips": "14.0.0",
    "@material/fab": "14.0.0",
    "@material/ripple": "14.0.0",
    "github-repository": "0.4.0",
    "node-package": "1.4.0",
    "webfontloader": "1.6.28",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/node": "26.6.2",
    "@types/webfontloader": "1.6.38",
    "astro": "7.4.0",
    "concurrently": "10.0.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-prettier": "5.5.6",
    "firebase-tools": "15.31.0",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-package": "2.0.0",
    "sass": "1.103.1",
    "stylelint": "17.15.0",
    "stylelint-config-sass-guidelines": "13.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-scss": "7.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "workbox-build": "7.4.1"
  }
