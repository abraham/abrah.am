---
import { Picture } from 'astro:assets';
import avatar from '../assets/abraham.jpg';
import Chip from '../components/Chip.astro';
import Fab from '../components/Fab.astro';
import GitHubRepoCard from '../components/GitHubRepoCard.astro';
import MastodonPost from '../components/MastodonPost.astro';
import NpmPackageCard from '../components/NpmPackageCard.astro';
import { links } from '../data/links';
import { mastodon } from '../data/mastodon';
import Base from '../layouts/Base.astro';
import { fetchSiteData } from '../lib/sources/index.ts';
import '../styles/global.css';

const {
  packages,
  repos,
  mastodon: { posts },
} = await fetchSiteData();

const promos = [
  {
    url: 'https://meowstodon.app/',
    name: 'Meowstodon',
    description: 'The purrfect Mastodon app for Android',
  },
  {
    url: 'https://dieselpunk.dev/',
    name: 'Dieselpunk UI',
    description: 'Industrial game-style Web Components',
  },
  {
    url: 'https://dockerfile.pub/',
    name: 'Dockerfile Explainer',
    description: 'Learn what each Dockerfile instruction does',
  },
  {
    url: 'https://daily.cat/',
    name: 'Daily Cat',
    description: 'A new cat photo from Unsplash every day',
  },
];
---

<Base title="Abraham Williams" description="Abraham Williams is a software engineer in Madison, WI working for GitHub">
  <header class="hero">
    <div class="hero__inner">
      <Picture
        src={avatar}
        formats={['avif', 'webp']}
        width={240}
        height={240}
        densities={[1, 2]}
        alt="Abraham Williams"
        class="hero__avatar"
        itemprop="image"
        loading="eager"
        fetchpriority="high"
      />
      <h1 class="hero__title">
        <span class="hero__hello">Hello, I'm</span>
        <span class="hero__name" itemprop="name">
          Abraham Williams
        </span>
      </h1>
    </div>
  </header>

  <main class="content">
    <section>
      {/* Break lines only between words: Astro drops newline whitespace next to tags. */}
      <!-- prettier-ignore -->
      <p class="description" itemprop="description">
        I'm an experienced developer, startup founder, and <a rel="noopener" href="https://slides.today">international speaker</a>,
        who brings a broad range of skills to my current role as a software engineer at <a rel="noopener" href="https://github.com/">GitHub</a>.
        A top 1% contributor at <a rel="noopener" href="https://stackoverflow.com/users/story/26406">Stack Overflow</a> and
        formerly a developer relations engineer at <a rel="noopener" href="https://developers.google.com/">Google</a>, a
        senior developer at <a rel="noopener" href="https://bendyworks.com/">Bendyworks</a>, an organizer of <a rel="noopener" href="https://gdgmadison.com">GDG Madison</a>,
        and a <a rel="noopener" href="https://developers.google.com/experts/people/abraham-williams">Google Developer Expert</a>.
      </p>
    </section>

    <section>
      <h2>Profiles</h2>

      <ul class="chips">
        {links.map((link) => (
          <li>
            <Chip link={link} />
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Recent posts</h2>

      {posts.length > 0 && (
        <div class="grid">
          {posts.map((post) => (
            <MastodonPost post={post} />
          ))}
        </div>
      )}

      <p class="more">
        <a class="button" href={mastodon.profileUrl} rel="noopener me">
          See my posts on Mastodon
        </a>
      </p>
    </section>

    <section>
      <h2>Projects</h2>

      <ul class="promos">
        {promos.map((promo) => (
          <li>
            <a class="promo" href={promo.url}>
              <span class="promo__name">{promo.name}</span>
              {promo.description}
            </a>
          </li>
        ))}
      </ul>

      <div class="grid">
        {packages.map((pkg) => (
          <NpmPackageCard pkg={pkg} />
        ))}
      </div>

      <div class="grid">
        {repos.map((repo) => (
          <GitHubRepoCard repo={repo} />
        ))}
      </div>
    </section>
  </main>

  <footer>
    <Fab href="https://indieweb.social/@abraham" />
  </footer>

  <script>
    import '../scripts/main';
  </script>
</Base>
