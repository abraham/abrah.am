---
import type { NpmPackageCard as Pkg } from '../lib/sources/npm';

interface Props {
  pkg: Pkg;
}

const { pkg } = Astro.props;
const install = `npm install ${pkg.name}${pkg.global ? ' --global' : ''}`;
---

<article class="card">
  <header class="card__header">
    <h3 class="card__title">
      <a href={pkg.url} rel="noopener">
        {pkg.name}
      </a>
    </h3>
    <svg class="card__logo" viewBox="0 0 18 7" aria-hidden="true">
      <path fill="#cb3837" d="M0,0h18v6H9v1H5V6H0V0z"></path>
      <path
        fill="#fff"
        d="M1,5h2V2h1v3h1V1H1V5z M6,1v5h2V5h2V1H6z M8,2h1v2H8V2z M11,1v4h2V2h1v3h1V2h1v3h1V1H11z"
        fill-rule="evenodd"
      ></path>
    </svg>
  </header>

  {pkg.description && <p class="card__description">{pkg.description}</p>}

  <ul class="card__meta">
    {pkg.deprecated && <li class="card__badge">Deprecated</li>}
    {pkg.version && <li>v{pkg.version}</li>}
    {pkg.license && <li>{pkg.license}</li>}
  </ul>

  <code class="card__install">{install}</code>
</article>
