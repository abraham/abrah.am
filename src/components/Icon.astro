const icons = { ...materialIcons, ...brandIcons };

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
// Brand logos fill the whole 24px box; Material icons leave ~2px padding.
const viewBox = name in brandIcons ? '-2 -2 28 28' : '0 0 24 24';
---

<svg class={className} viewBox={viewBox} fill="currentColor" aria-hidden="true">
  {icons[name].map((d) => (
    <path d={d} />
  ))}
</svg>
