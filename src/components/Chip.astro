---
import type { ProfileLink } from '../data/links';
import Icon from './Icon.astro';

interface Props {
  link: ProfileLink;
}

const { link } = Astro.props;
---

<a
  class="chip"
  href={link.url}
  itemprop={link.sameAs ? 'sameAs' : undefined}
  rel={link.relMe ? 'noopener me' : 'noopener'}
>
  <Icon name={link.icon} class="chip__icon" />
  <span>{link.text}</span>
</a>
